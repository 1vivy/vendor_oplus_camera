app_domain(opluscamera_app)
net_domain(opluscamera_app)
hal_client_domain(opluscamera_app, vendor_hal_dspmanager)
# Camera HAL client: required so opluscamera_app can `find` IOfflineCameraService
# (vendor.qti.hardware.camera.offlinecamera, co-hosted by the camera-provider daemon).
# Without hal_camera_client membership the offline (ncs) streams the AutoHDR/fusion
# snapshot path acquires never drain -> OEM HealthMonitor SIGABRT 'ncsUnreleased 16'.
# A naked `allow ... find` fails the offline-service neverallow (the domain must JOIN the
# attribute); hal_client_domain adds halclientdomain + hal_camera_client (CTS-clean on
# Treble). Stock places opluscamera_app in hal_camera_client. (verified via setenforce 0)
hal_client_domain(opluscamera_app, hal_camera)

allow opluscamera_app adsprpcd_file:dir r_dir_perms;
allow opluscamera_app public_adsprpcd_file:file r_file_perms;

allow opluscamera_app vendor_data_file:dir  { read open search write add_name remove_name create getattr };
allow opluscamera_app vendor_data_file:file { read open write create unlink getattr };
allow opluscamera_app vendor_camera_update_data_file:file { read open write create unlink getattr };
allow opluscamera_app vendor_camera_update_data_file:dir { read open search write add_name remove_name create getattr };
allow opluscamera_app vendor_xdsp_device:file { read open write create unlink getattr };
allow opluscamera_app vendor_xdsp_device:dir { read open search write add_name remove_name create getattr };
allow opluscamera_app vendor_qdsp_device:file { read open write create unlink getattr };
allow opluscamera_app vendor_qdsp_device:dir { read open search write add_name remove_name create getattr };
allow opluscamera_app proc_ufs_file:file r_file_perms;
allow opluscamera_app opluscamera_app_data_file:file { read open write create unlink getattr };
allow opluscamera_app opluscamera_app_data_file:dir { read open search write add_name remove_name create getattr };

# FastRPC devices
# vendor_qdsp_device: read-only only — neverallow on SM8750 blocks write/append
# for non-HAL domains. The camera app only needs to open/read/ioctl for DSP
# session setup; actual writes go through the HAL.
allow opluscamera_app vendor_qdsp_device:chr_file { ioctl read };
dontaudit opluscamera_app vendor_qdsp_device:chr_file open;
dontaudit opluscamera_app vendor_xdsp_device:chr_file { getattr ioctl open read write create unlink };

# selinuxfs
allow opluscamera_app selinuxfs:file { read open };

# ADSP RPC dir search
allow opluscamera_app adsprpcd_file:dir search;

# Binder: camera app ↔ camera HAL
allow opluscamera_app hal_camera_default:binder { call transfer };

# Camera properties
get_prop(opluscamera_app, vendor_camera_prop)
dontaudit opluscamera_app default_prop:file { read open getattr map };
get_prop(opluscamera_app, camera_config_prop)
binder_use(opluscamera_app)
binder_call(opluscamera_app, system_server)
binder_call(opluscamera_app, surfaceflinger)
allow opluscamera_app vendor_default_prop:file { open read getattr map };



allow opluscamera_app activity_service:service_manager find;
allow opluscamera_app display_service:service_manager find;
allow opluscamera_app surfaceflinger_service:service_manager find;
allow opluscamera_app package_native_service:service_manager find;
allow opluscamera_app permission_service:service_manager find;
dontaudit opluscamera_app vendor_hal_qspmhal_service:service_manager find;


# Allow binder communication with QSPM HAL
allow opluscamera_app vendor_hal_qspmhal_default:binder { call transfer };


# Offline camera post-processing service (IOfflineCameraService) is protected by
# hal_camera policy. opluscamera_app IS now a hal_camera_client (see hal_client_domain
# at top) so it can `find` the service -- CTS-clean on Treble, matches stock. (The earlier
# "do not mark as hal_camera client" note was wrong: the find-denial caused the AutoHDR
# fusion path's offline streams to leak -> 'ncsUnreleased 16' watchdog abort.)
